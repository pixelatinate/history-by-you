# Copy to .env.local and fill in once you've created a Supabase project
# (https://supabase.com/dashboard -> New project -> Project Settings -> API).
# Until these are set, the app renders MOCK_LOCATIONS from @history-by-you/db
# instead of hitting a real database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
